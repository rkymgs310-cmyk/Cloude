---
// AdSenseの審査が通り、環境変数 PUBLIC_ADSENSE_CLIENT_ID / PUBLIC_ADSENSE_SLOT_ID
// を設定するまでは何も表示しない(空枠のまま公開するとポリシー違反になるため)。
interface Props {
  slot?: string;
}
const { slot = import.meta.env.PUBLIC_ADSENSE_SLOT_ID } = Astro.props;
const clientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const ready = Boolean(clientId && slot);
---
{ready && (
  <div class="ad-slot">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={clientId}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
<style>
  .ad-slot { margin: 2rem 0; text-align: center; }
</style>
