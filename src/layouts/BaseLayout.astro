---
interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
}

const { title, description, ogType = 'website', publishedDate, updatedDate } = Astro.props;
const siteName = 'ガジェット比較ラボ';
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
const rssUrl = new URL('/rss.xml', Astro.site ?? 'https://example.com').href;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href={rssUrl} />

  <!-- Google Fonts: Inter & Noto Sans JP -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
    rel="stylesheet"
  />

  <!-- OGP & Twitter Cards -->
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />

  {adsenseClientId && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
      crossorigin="anonymous"
    ></script>
  )}

  <slot name="head" />

  <style is:global>
    :root {
      --bg: #090d16;
      --bg-elevated: #111827;
      --surface: #151d2e;
      --surface-hover: #1c263c;
      --border: rgba(255, 255, 255, 0.08);
      --border-accent: rgba(99, 102, 241, 0.35);
      --fg: #f3f4f6;
      --fg-secondary: #94a3b8;
      --fg-muted: #64748b;
      --accent-start: #3b82f6;
      --accent-end: #8b5cf6;
      --accent-glow: rgba(59, 130, 246, 0.2);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --max-width: 840px;
      --shadow-subtle: 0 4px 20px -2px rgba(0, 0, 0, 0.5);
      --shadow-hover: 0 10px 30px -4px rgba(59, 130, 246, 0.25);
    }

    @media (prefers-color-scheme: light) {
      :root {
        --bg: #f8fafc;
        --bg-elevated: #ffffff;
        --surface: #ffffff;
        --surface-hover: #f1f5f9;
        --border: rgba(0, 0, 0, 0.08);
        --border-accent: rgba(59, 130, 246, 0.25);
        --fg: #0f172a;
        --fg-secondary: #334155;
        --fg-muted: #64748b;
        --accent-glow: rgba(59, 130, 246, 0.1);
        --shadow-subtle: 0 4px 20px -2px rgba(0, 0, 0, 0.06);
        --shadow-hover: 0 10px 30px -4px rgba(59, 130, 246, 0.15);
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg);
      color: var(--fg);
      line-height: 1.8;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--accent-start);
      text-decoration: none;
      transition: color 0.2s ease, opacity 0.2s ease;
    }

    a:hover {
      opacity: 0.85;
    }

    img {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
    }

    /* Common Card Styling */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-subtle);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
      border-color: var(--border-accent);
    }

    /* Badge & Tag Pill */
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.2rem 0.65rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 500;
      background: rgba(59, 130, 246, 0.12);
      color: var(--accent-start);
      border: 1px solid rgba(59, 130, 246, 0.25);
      transition: all 0.2s ease;
    }

    .badge-pill:hover {
      background: var(--accent-start);
      color: #ffffff;
    }
  </style>

  <style>
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(9, 13, 22, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }

    @media (prefers-color-scheme: light) {
      .site-header {
        background: rgba(255, 255, 255, 0.85);
      }
    }

    .header-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0.9rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--fg);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.01em;
    }

    .brand-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
      color: #ffffff;
      font-size: 1rem;
      box-shadow: 0 2px 8px var(--accent-glow);
    }

    .brand-name {
      background: linear-gradient(135deg, var(--fg) 60%, var(--fg-secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--fg-secondary);
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    .nav-links a:hover {
      color: var(--fg);
      opacity: 1;
    }

    .main-content {
      flex: 1;
      max-width: var(--max-width);
      width: 100%;
      margin: 0 auto;
      padding: 2.5rem 1.25rem 4rem;
    }

    .site-footer {
      border-top: 1px solid var(--border);
      background: var(--bg-elevated);
      color: var(--fg-muted);
      font-size: 0.85rem;
      margin-top: auto;
    }

    .footer-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 2.5rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .footer-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .footer-nav a {
      color: var(--fg-secondary);
      transition: color 0.2s ease;
    }

    .footer-nav a:hover {
      color: var(--accent-start);
    }

    .footer-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      border-top: 1px solid var(--border);
      padding-top: 1.25rem;
    }

    .footer-meta a {
      color: var(--fg-muted);
    }

    @media (max-width: 600px) {
      .header-inner {
        padding: 0.75rem 1rem;
      }
      .brand-link {
        font-size: 1rem;
      }
      .nav-links {
        gap: 0.85rem;
        font-size: 0.85rem;
      }
      .main-content {
        padding: 1.5rem 1rem 3rem;
      }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand-link" aria-label="ガジェット比較ラボ トップ">
        <span class="brand-icon">⚡</span>
        <span class="brand-name">{siteName}</span>
      </a>
      <nav aria-label="メインナビゲーション">
        <ul class="nav-links">
          <li><a href="/">ホーム</a></li>
          <li><a href="/tags/">タグ一覧</a></li>
          <li><a href="/about/">運営者情報</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-nav">
        <a href="/">トップページ</a>
        <a href="/tags/">タグ一覧</a>
        <a href="/about/">運営者情報</a>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="/contact/">お問い合わせ</a>
        <a href="/rss.xml" target="_blank" rel="noopener">RSSフィード</a>
      </div>
      <div class="footer-meta">
        <p>&copy; {new Date().getFullYear()} {siteName}. All rights reserved.</p>
        <p>AIツール・スマート家電・便利ガジェットの徹底比較</p>
      </div>
    </div>
  </footer>
</body>
</html>
