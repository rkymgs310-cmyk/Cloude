---
interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogType = 'website' } = Astro.props;
const siteName = 'ガジェット比較ラボ';
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  {adsenseClientId && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
      crossorigin="anonymous"
    ></script>
  )}
  <style>
    :root {
      color-scheme: light dark;
      --max-width: 760px;
      --fg: #1a1a1a;
      --bg: #ffffff;
      --muted: #666;
      --accent: #0a6cff;
    }
    @media (prefers-color-scheme: dark) {
      :root { --fg: #eaeaea; --bg: #121212; --muted: #aaa; }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
      color: var(--fg);
      background: var(--bg);
      line-height: 1.8;
    }
    header, footer {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 1.25rem 1rem;
    }
    header a { color: var(--fg); text-decoration: none; font-weight: 700; font-size: 1.25rem; }
    main {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 1rem 3rem;
    }
    footer {
      border-top: 1px solid #8883;
      color: var(--muted);
      font-size: 0.85rem;
    }
    footer nav a { color: var(--muted); margin-right: 1rem; }
    h1 { font-size: 1.8rem; }
    a { color: var(--accent); }
    img { max-width: 100%; height: auto; }
  </style>
</head>
<body>
  <header>
    <a href="/">{siteName}</a>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <nav>
      <a href="/about/">運営者情報</a>
      <a href="/privacy/">プライバシーポリシー</a>
      <a href="/contact/">お問い合わせ</a>
    </nav>
    <p>&copy; {new Date().getFullYear()} {siteName}</p>
  </footer>
</body>
</html>
