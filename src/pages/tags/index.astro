---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);

// タグごとに記事数を集計
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => {
  // 記事件数順（降順）→ タグ名順
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0], 'ja');
});
---
<BaseLayout
  title="タグ一覧"
  description="ガジェット比較ラボの記事タグ一覧です。スマート家電、AIツール、周辺機器など関心のあるテーマから記事を探せます。"
>
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <a href="/">ホーム</a>
    <span class="separator">/</span>
    <span class="current">タグ一覧</span>
  </nav>

  <header class="page-header">
    <h1 class="page-title">タグ一覧</h1>
    <p class="page-desc">関心のあるカテゴリーやキーワードから記事を探せます。</p>
  </header>

  <div class="tags-container">
    {sortedTags.map(([tag, count]) => (
      <a href={`/tags/${encodeURIComponent(tag)}/`} class="card tag-card">
        <div class="tag-card-content">
          <span class="tag-name">#{tag}</span>
          <span class="tag-count">{count} 記事</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb a {
    color: var(--fg-secondary);
  }

  .breadcrumb .separator {
    color: var(--fg-muted);
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .page-desc {
    color: var(--fg-secondary);
    font-size: 0.95rem;
  }

  .tags-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .tag-card {
    padding: 1.25rem;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .tag-card-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tag-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--fg);
    transition: color 0.2s ease;
  }

  .tag-card:hover .tag-name {
    color: var(--accent-start);
  }

  .tag-count {
    font-size: 0.8rem;
    color: var(--fg-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  @media (prefers-color-scheme: light) {
    .tag-count {
      background: rgba(0, 0, 0, 0.05);
    }
  }
</style>
